{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ai-island",
  "version": "0.1.0",
  "identifier": "com.aiisland.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ai-island",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "test-panel",
        "title": "Island Test Panel",
        "url": "test-panel.html",
        "width": 380,
        "height": 480,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:34567;"
    }
  },
  "bundle": {
    "active": false
  }
}
